# Discord
DISCORD_TOKEN=your_bot_token

# Groq
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=mixtral-8x7b-32768

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DATABASE=ticket_bot

# Support role (ID)
SUPPORT_ROLE_ID=123456789012345678

# Ticket detection (comma-separated, optional)
TICKET_CATEGORY_IDS=123456789,987654321
TICKET_CHANNEL_IDS=111111111,222222222
# Channel name pattern regex (optional, e.g., ^ticket-.*)
TICKET_NAME_PATTERN=^ticket-

# Knowledge indexing.
# Whitelist mode: if KNOWLEDGE_CHANNEL_IDS is non-empty, ONLY those channels are indexed.
KNOWLEDGE_CHANNEL_IDS=
# Index-all mode: when the whitelist above is empty and this is true, every server text
# channel is indexed except KNOWLEDGE_BLACKLIST_IDS and all ticket channels/categories.
KNOWLEDGE_INDEX_ALL=true
# Channels to EXCLUDE from indexing (index-all mode).
KNOWLEDGE_BLACKLIST_IDS=

# How many past ticket messages to feed the model (default 15).
HISTORY_LIMIT=15

# AI moderation of knowledge indexing: decide via the model whether a candidate
# message is useful knowledge before storing it (costs Groq requests).
KNOWLEDGE_AI_FILTER=true

# Staff handover: when a support-role member writes in the ticket the bot stops
# answering. It resumes on @mention or after this many silent minutes.
STAFF_TIMEOUT_MINUTES=30

# Logging level
LOG_LEVEL=INFO
